# ---------- Base de données ----------
POSTGRES_DB=srm_fleet
POSTGRES_USER=srm_user
POSTGRES_PASSWORD=change-me

# ---------- Ports exposés ----------
BACKEND_PORT=8080
FRONTEND_PORT=4200

# ---------- Sécurité JWT ----------
JWT_SECRET=change-moi-par-une-chaine-aleatoire-de-32-caracteres-minimum
JWT_EXPIRATION_MS=86400000

# ---------- Compte administrateur initial ----------
# Mot de passe posé sur le compte 'admin' au tout premier démarrage.
# Obligatoire : sans valeur, le compte admin reste inutilisable. À changer après connexion.
APP_ADMIN_INITIAL_PASSWORD=change-moi-par-un-mot-de-passe-fort
