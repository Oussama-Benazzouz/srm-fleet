<configuration>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Développement local : verbeux -->
  <springProfile name="dev">
    <root level="DEBUG">
      <appender-ref ref="CONSOLE" />
    </root>
  </springProfile>

  <!-- Conteneur Docker et production : sortie standard, niveau INFO -->
  <springProfile name="docker,prod">
    <root level="INFO">
      <appender-ref ref="CONSOLE" />
    </root>
  </springProfile>

  <!-- Aucun profil actif (ex. démarrage nu) : garde-fou pour toujours logger -->
  <springProfile name="default">
    <root level="INFO">
      <appender-ref ref="CONSOLE" />
    </root>
  </springProfile>

</configuration>
